    </LoopInitiator>
    <Routine name="word_presentation"/>
    <Routine name="blank_1s"/>
    <LoopTerminator name="encoding_loop"/>
    <Routine name="start_recall"/>
    <LoopInitiator loopType="TrialHandler" name="recall_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
