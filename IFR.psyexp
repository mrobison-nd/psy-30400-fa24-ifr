      <Param name="conditions" updates="None" val="[OrderedDict([('Word', 'music')]), OrderedDict([('Word', 'angel')]), OrderedDict([('Word', 'intro')]), OrderedDict([('Word', 'thing')]), OrderedDict([('Word', 'straw')]), OrderedDict([('Word', 'dough')]), OrderedDict([('Word', 'metal')]), OrderedDict([('Word', 'shelf')]), OrderedDict([('Word', 'liver')]), OrderedDict([('Word', 'pearl')])]" valType="str"/>
